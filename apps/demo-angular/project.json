{
  "name": "demo-angular",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/demo-angular/src",
  "projectType": "application",
  "prefix": "demo",
  "targets": {
    "build": {
      "executor": "@nativescript/nx:build",
      "options": {
        "noHmr": true
      },
      "configurations": {
        "release": {
          "production": true,
          "uglify": true,
          "release": true,
          "forDevice": true
        }
      },
      "dependsOn": [
        {
          "target": "build.all",
          "dependencies": true
        }
      ]
    },
    "ios": {
      "executor": "@nativescript/nx:build",
      "options": {
        "platform": "ios",
        "noHmr": true,
        "release": false,
        "forDevice": false,
        "production": false,
        "uglify": false
      },
      "dependsOn": [
        {
          "target": "build.all",
          "dependencies": true
        }
      ]
    },
    "android": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["ns run android --no-hmr --force"],
        "parallel": false,
        "cwd": "apps/demo-angular"
      },
      "dependsOn": [
        {
          "target": "build.all",
          "dependencies": true
        }
      ]
    },
    "clean": {
      "executor": "@nativescript/nx:build",
      "options": {
        "clean": true
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
