{
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": true,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "noEmitHelpers": false,
    "allowSyntheticDefaultImports": true,
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ESNext", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "types": ["node"],
    "plugins": [
      {
        "transform": "@nativescript/webpack/dist/transformers/NativeClass",
        "type": "raw"
      }
    ],
    "paths": {
      "@demo/shared": ["./tools/demo/index.ts"],
      "@herefishyfish/*": ["./packages/*"],
      "@herefishyfish/nativescript-lokijs": ["./packages/nativescript-lokijs/index.d.ts"],
      "@herefishyfish/nativescript-rxdb": ["./packages/nativescript-rxdb/index.ts"],
      "@herefishyfish/nativescript-sqlite-rxstorage-adapter": ["./packages/nativescript-sqlite-rxstorage-adapter/index.ts"],
      "@herefishyfish/nativescript-opfs": ["./packages/nativescript-opfs/index.d.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
